# ------------------------------------------------------------------
# BMP - Belludi Masala Products — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# ------------------------------------------------------------------

# Public Supabase config (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Never expose to the client.
# Used by the seed script and privileged server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NOTE: Admin access is controlled by the `public.admins` table in the DB
# (seeded via migration, single source of truth for the is_admin() check),
# NOT by an env var. Add an admin with:
#   insert into public.admins (email) values ('you@example.com');

# Base URL of the site (used for metadata / absolute links + auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (transactional emails: order confirmation + status updates)
# Get an API key at https://resend.com. Leave blank to disable emails locally.
RESEND_API_KEY=
# Verified sender. Use "onboarding@resend.dev" for testing, or your own domain.
EMAIL_FROM=BMP — Belludi Masala <onboarding@resend.dev>
